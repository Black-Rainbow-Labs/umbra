{% if output.exception_info -%}
<exception>{{output.exception_info}}</exception>
{% endif -%}
<returncode>{{output.returncode}}</returncode>
{%- set limit = output_limit if output_limit is defined else 10000 -%}
{%- set half = limit // 2 -%}
{% if output.output | length < limit -%}
<output>
{{ output.output -}}
</output>
{%- else -%}
<warning>
The output of your last command was too long.
Please try a different command that produces less output.
If you're looking at a file you can try use head, tail or sed to view a smaller number of lines selectively.
If you're using grep or find and it produced too much output, you can use a more selective search pattern.
If you really need to see something from the full command's output, you can redirect output to a file and then search in that file.
</warning>
{%- set elided_chars = output.output | length - 2 * half -%}
<output_head>
{{ output.output[:half] }}
</output_head>
<elided_chars>
{{ elided_chars }} characters elided
</elided_chars>
<output_tail>
{{ output.output[-half:] }}
</output_tail>
{%- endif -%}
{%- if output.output_file is defined and output.output_file %}
<full_output_file>{{ output.output_file }}</full_output_file>
<note>The whole output is in this file, with any line over 2000 characters that was cut above. Search it with grep -n or read a part with sed -n instead of running the command again.</note>
{%- endif -%}
